// =====================================================================
// Rule: Password spraying - one IP tries many DIFFERENT accounts
// MITRE ATT&CK: T1110.003 (Brute Force: Password Spraying)
// Severity: High
// Schedule: run every 5 minutes, look back 10 minutes
//
// Brute force hammers one account; spraying tries one or two common
// passwords against many accounts to stay under lockout limits.
// Counting DISTINCT usernames per IP is what tells them apart.
// =====================================================================
let distinctAccountThreshold = 5;   // different usernames from one IP...
let windowSize = 5m;                // ...inside this window
SecurityEvent
| where TimeGenerated > ago(10m)
| where EventID == 4625
| where isnotempty(IpAddress)
    and IpAddress !in ("-", "127.0.0.1", "::1")
    and isnotempty(TargetUserName)
| summarize
    DistinctAccounts = dcount(TargetUserName),
    FailedAttempts   = count(),
    AccountsTried    = make_set(TargetUserName, 50),
    FirstSeen        = min(TimeGenerated),
    LastSeen         = max(TimeGenerated)
    by IpAddress, Computer, bin(TimeGenerated, windowSize)
| where DistinctAccounts >= distinctAccountThreshold
| extend Geo = geo_info_from_ip_address(IpAddress)
| extend Country = tostring(Geo.country), City = tostring(Geo.city)
| project FirstSeen, LastSeen, IpAddress, Country, City, Computer,
          DistinctAccounts, FailedAttempts, AccountsTried
| order by DistinctAccounts desc
